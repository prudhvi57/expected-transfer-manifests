{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "feed_id": {
      "type": "string",
      "minLength": 1
    },
    "partner_id": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_id": {
      "type": "string",
      "format": "date"
    },
    "kind": {
      "enum": [
        "transfer",
        "transport_receipt",
        "business_ack"
      ]
    },
    "status": {
      "enum": [
        "success",
        "failed"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "transfer_id": {
      "type": "string",
      "minLength": 1
    },
    "ack_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "feed_id",
    "partner_id",
    "occurrence_id",
    "kind",
    "status",
    "timestamp"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "transfer"
          }
        }
      },
      "then": {
        "required": [
          "transfer_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "business_ack"
          }
        }
      },
      "then": {
        "required": [
          "ack_ref"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETM 1.0 event"
}
