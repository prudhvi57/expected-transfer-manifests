{
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "1.0"
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "partner_id": {
            "type": "string",
            "minLength": 1
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "weekly",
                  "nth_weekday"
                ]
              },
              "weekday": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "nth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "kind",
              "weekday",
              "time"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "nth_weekday"
                    }
                  }
                },
                "then": {
                  "required": [
                    "nth"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "nth"
                    ]
                  }
                }
              }
            ]
          },
          "grace_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "ack": {
            "type": "object",
            "properties": {
              "days_after": {
                "type": "integer",
                "minimum": 0
              },
              "time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            },
            "required": [
              "days_after",
              "time"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "partner_id",
          "timezone",
          "schedule",
          "grace_minutes",
          "ack"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "spec_version",
    "feeds"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETM 1.0 manifest"
}
